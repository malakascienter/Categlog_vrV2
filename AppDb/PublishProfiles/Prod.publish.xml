<?xml version="1.0" encoding="utf-8"?>
<!--
  PRODUCTION. Safest settings:
   - never drop data or objects that are not in the project
   - back up the database before deploying
   - always generate the script first (scripts\New-DeployScript.ps1) and review it
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetDatabaseName>AppDb</TargetDatabaseName>
    <DeployScriptFileName>AppDb.Prod.sql</DeployScriptFileName>
    <ProfileVersionNumber>1</ProfileVersionNumber>

    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <BackupDatabaseBeforeChanges>True</BackupDatabaseBeforeChanges>
    <BlockWhenDriftDetected>True</BlockWhenDriftDetected>
    <RegisterDataTierApplication>True</RegisterDataTierApplication>
    <IncludeTransactionalScripts>True</IncludeTransactionalScripts>
  </PropertyGroup>
  <ItemGroup>
    <SqlCmdVariable Include="Environment">
      <Value>Prod</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>
