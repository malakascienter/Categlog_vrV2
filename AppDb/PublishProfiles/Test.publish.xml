<?xml version="1.0" encoding="utf-8"?>
<!-- TEST / QA server. Connection string comes from the pipeline. No sample data. -->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetDatabaseName>AppDb</TargetDatabaseName>
    <DeployScriptFileName>AppDb.Test.sql</DeployScriptFileName>
    <ProfileVersionNumber>1</ProfileVersionNumber>

    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>True</DropObjectsNotInSource>
    <DoNotDropObjectTypes>Users;Logins;RoleMembership;Permissions</DoNotDropObjectTypes>
    <IncludeTransactionalScripts>True</IncludeTransactionalScripts>
  </PropertyGroup>
  <ItemGroup>
    <SqlCmdVariable Include="Environment">
      <Value>Test</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>
